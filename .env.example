# =============================================================================
# Modelo das variáveis de ambiente do Finator.
#
#   cp .env.example .env    # e preencha com os valores reais
#
# O .env está no .gitignore e NUNCA deve ser versionado: contém endereços da
# sua rede e senhas.
# =============================================================================

# Servidor PostgreSQL (o mesmo para todos os serviços; cada um tem seu database)
FINATOR_DB_HOST=db.example.local
FINATOR_DB_PORT=5432

# identity-service
IDENTITY_DB_NAME=finator_identity
IDENTITY_DB_USER=finator_identity
IDENTITY_DB_PASSWORD=change-me

# ledger-service
LEDGER_DB_NAME=finator_ledger
LEDGER_DB_USER=finator_ledger
LEDGER_DB_PASSWORD=change-me
